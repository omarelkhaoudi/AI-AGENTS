# PostgreSQL connection string used by Prisma. Fill locally in .env; never commit real credentials.
DATABASE_URL=""

# AI provider boundary. Keep disabled until a real provider client is configured.
AI_PROVIDER="openai"
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gpt-5"
AI_PROVIDER_ENABLED="false"

# Workflow boundary. n8n will be called through this base URL when enabled.
WORKFLOW_PROVIDER="n8n"
WORKFLOW_BASE_URL="http://localhost:5678"
WORKFLOW_ENABLED="false"
