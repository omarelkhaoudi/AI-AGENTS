# HTTPS in front of the cockpit. Caddy obtains the certificate from Let's
# Encrypt for the domain in deploy/.env and renews it by itself; the domain's DNS
# must point at this server first.
#
# The client companies of the SaaS (scripts/tenant.sh) each add one file in
# deploy/tenants-caddy/, with the same protections.
(cockpit) {
	encode zstd gzip

	# Photos and documents joined to the Director can weigh up to 40 MB.
	request_body {
		max_size 45MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
}

import /etc/caddy/tenants/*.caddy

{$DOMAIN} {
	import cockpit
	reverse_proxy app:3000 {
		# While a new version starts, a request waits for it instead of failing.
		lb_try_duration 30s
	}
}
