# Copy to deploy/backup-offsite.env on the server (chmod 600). Both values are
# secrets: never commit the real file.
#
# The address of the pre-authenticated request on the backup bucket (Oracle
# console > Object Storage > the bucket > Pre-authenticated requests > Create:
# "Bucket", "Permit object reads and writes"), ending with /o/.
BACKUP_OFFSITE_URL=""
# A file holding the encryption passphrase, one line. Keep a copy of the
# passphrase with the direction, outside the server: without it the copies
# cannot be read.
BACKUP_PASSPHRASE_FILE="/opt/hkids/deploy/backup-passphrase"
