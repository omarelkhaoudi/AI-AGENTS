# PostgreSQL connection string used by Prisma. Fill locally in .env; never commit real credentials.
# With the bundled docker-compose.yml the local value is:
#   postgresql://ai_agents:ai_agents_local_dev@localhost:5433/ai_agents?schema=public
DATABASE_URL=""

# Where business records are stored. "memory" keeps the offline default and
# needs no database; "postgres" reads them through Prisma and requires a valid
# DATABASE_URL. This is independent of BUSINESS_DATA_PROVIDER below, which says
# where the records came from rather than where they are kept.
BUSINESS_MEMORY_PROVIDER="memory"

# PostgreSQL integration tests are opt-in. Set this to true, with a valid
# DATABASE_URL, to run the ten tests that are skipped otherwise.
RUN_POSTGRES_INTEGRATION="false"

# Business data source. Keep demo by default; future_real_data is an offline placeholder only.
BUSINESS_DATA_PROVIDER="demo"
BUSINESS_DATA_SOURCE_ID="demo"
BUSINESS_PROVIDER_ADAPTER="demo"

# AI provider boundary. Keep disabled until a real provider client is configured.
AI_PROVIDER="openai"
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gpt-5"
AI_PROVIDER_ENABLED="false"

# Planner selection. Supported values: deterministic, stub_llm, llm_mock, llm_openai.
PLANNER_PROVIDER="deterministic"

# LLM provider boundary. OpenAI is only used when PLANNER_PROVIDER="llm_openai".
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"

# Workflow boundary. Off by default. Setting WORKFLOW_ENABLED="true" requires
# WORKFLOW_PROVIDER="n8n" and a WORKFLOW_BASE_URL that can actually be called,
# otherwise the application refuses to start. Enabled is not connected: no
# adapter calls n8n yet.
WORKFLOW_PROVIDER="mock"
WORKFLOW_BASE_URL=""
WORKFLOW_ENABLED="false"

# n8n specifics, required only once the boundary is enabled. The base URL is
# WORKFLOW_BASE_URL above: there is deliberately no second variable for it.
N8N_WEBHOOK_PATH=""
N8N_API_KEY_HEADER="X-AI-Agents-Token"
# Never fill this in here. It belongs in .env, which is git-ignored.
N8N_API_KEY=""
# Milliseconds. An unreachable n8n must not hold an orchestration step open.
N8N_TIMEOUT_MS="5000"

# API authentication. "token" requires a real bearer token for every /api call.
# "demo" additionally exposes GET /api/auth/demo-session and is refused when
# NODE_ENV=production. Create tokens with: npm run auth:create-token
AUTH_MODE="token"

# Request limits and rate limiting (per authenticated user, or per IP if anonymous).
API_BODY_LIMIT_BYTES="65536"
RATE_LIMIT_READ_MAX="240"
RATE_LIMIT_WRITE_MAX="60"
RATE_LIMIT_DECISION_MAX="20"
