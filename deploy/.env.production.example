# Copy to deploy/.env on the server and fill in. deploy/.env is ignored by git
# and must never be committed: it holds the OpenAI key and the database password.

# The address of the cockpit, e.g. cockpit.hkids.ma. Its DNS A record must point
# at the server before the first start, so Caddy can obtain the certificate.
DOMAIN=""

# A long random password for the database, e.g. from: openssl rand -base64 32
POSTGRES_PASSWORD=""

# The platform's portal (accounts, companies, the way into the cockpits), e.g.
# portail.hkids.ma, its DNS pointing at this server too, and its own database
# password. Its signing key is made once with:
#   mkdir -p secrets && docker run --rm --user "$(id -u)" -v "$PWD/secrets:/out" deploy-app:latest node scripts/platform-keys.mjs --out=/out/portail-signature.pem
#   sudo chown 1000:1000 secrets/portail-signature.pem
# (the portal runs as the image's user, uid 1000, which must read it), and the
# first command prints the PORTAL_PUBLIC_KEY line below.
PORTAL_DOMAIN=""
PLATFORM_POSTGRES_PASSWORD=""
# The cockpit's side: the portal's public key (it checks the entry tickets, it
# cannot make one) and the portal's address, for « Changer d'entreprise ».
# Empty: the cockpit does not open from the portal.
PORTAL_PUBLIC_KEY=""
PORTAL_URL=""

# The OpenAI key the agents use.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"
OPENAI_REASONING_EFFORT="low"

# A monthly budget for the AI, in dollars: an alert at 80 % and at 100 % (team
# feed and the direction's WhatsApp). Empty: the cost is followed, no budget.
HKIDS_AI_BUDGET_USD=""
# Shows the cost in dirhams too, e.g. "10".
HKIDS_USD_MAD=""

# The company's own data only: without these three lines the cockpit shows the
# demonstration figures (fictitious clients, payments and orders).
BUSINESS_DATA_PROVIDER="future_real_data"
BUSINESS_PROVIDER_ADAPTER="future_real_data"
BUSINESS_DATA_SOURCE_ID="future_real_data"

# Instagram and Facebook (see README, "Instagram et Facebook"). Webhook to give
# Meta: https://<DOMAIN>/webhooks/meta. Empty: nothing is sent to Meta.
META_PAGE_ID=""
META_PAGE_ACCESS_TOKEN=""
META_INSTAGRAM_ID=""
META_VERIFY_TOKEN=""
META_APP_SECRET=""

# How long a sign-in lasts on a device, in days.
SESSION_DAYS="30"

# Delay alerts sent through n8n, as on the office machine. Leave
# WORKFLOW_ENABLED="false" to keep them off.
WORKFLOW_PROVIDER="n8n"
WORKFLOW_ENABLED="false"
WORKFLOW_BASE_URL=""
N8N_WEBHOOK_PATH="delay-alert"
