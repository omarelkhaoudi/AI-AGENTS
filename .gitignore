node_modules/
.env
.env.*
!.env.example

# Documents produced by the H-KIDS generator. They are outputs, regenerable at
# will, and they carry customer data: an invoice names a person, an address and
# an amount. Nothing here belongs in the repository.
assets/documents/generated/

# Local H-KIDS reference templates. The generator overlays its values on a
# template PDF, and the templates are deliberately not versioned: the originals
# were filled documents carrying a customer's name and order. Put the company's
# templates here to make generation work on this machine; Git will never see
# them, and the path is named by HKIDS_INVOICE_TEMPLATE_PATH and
# HKIDS_DELIVERY_NOTE_TEMPLATE_PATH in .env.
assets/documents/hkids-local/

# Company data read by the agents (catalogue, prices). The repository is public.
data/

!deploy/.env.production.example

# The SaaS client companies (scripts/tenant.sh): their settings carry keys and
# passwords, their sites and exports carry their names and data.
deploy/tenants/
deploy/exports/
deploy/tenants-supprimees.log
deploy/tenants-caddy/*
!deploy/tenants-caddy/_aucune.caddy

# Python caches of the dessinateur méthodes' engine.
__pycache__/
.pytest_cache/

# Database dumps and document archives made by scripts/backup.sh.
backups/
# The backups and their off-site settings hold client data and secrets.
deploy/backups/
deploy/backup-offsite.env
# The portal's signing key.
deploy/secrets/
deploy/backup-passphrase
