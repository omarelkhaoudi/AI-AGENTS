# Copy to deploy/.env on the server and fill in. deploy/.env is ignored by git
# and must never be committed: it holds the OpenAI key and the database password.

# The address of the cockpit, e.g. cockpit.hkids.ma. Its DNS A record must point
# at the server before the first start, so Caddy can obtain the certificate.
DOMAIN=""

# A long random password for the database, e.g. from: openssl rand -base64 32
POSTGRES_PASSWORD=""

# The OpenAI key the agents use.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"
OPENAI_REASONING_EFFORT="low"

# How long a sign-in lasts on a device, in days.
SESSION_DAYS="30"

# Delay alerts sent through n8n, as on the office machine. Leave
# WORKFLOW_ENABLED="false" to keep them off.
WORKFLOW_PROVIDER="n8n"
WORKFLOW_ENABLED="false"
WORKFLOW_BASE_URL=""
N8N_WEBHOOK_PATH="delay-alert"
