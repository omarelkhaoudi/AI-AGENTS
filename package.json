{
  "name": "ai-agents-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 0 technical foundation for an enterprise AI agent platform.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node scripts/db-seed.mjs",
    "db:seed:business": "node scripts/db-seed-business.mjs",
    "auth:create-token": "node scripts/create-api-token.mjs",
    "auth:create-user": "node scripts/create-user.mjs",
    "auth:reset-2fa": "node scripts/reset-two-factor.mjs",
    "archive:shortcut": "node scripts/create-desktop-shortcut.mjs",
    "data:ingest": "node scripts/ingest-business-data.mjs",
    "data:import-hkids": "node scripts/import-hkids-workbook.mjs",
    "css:build": "tailwindcss -i src/frontend/tailwind.css -o src/frontend/styles.css --minify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.8",
    "openai": "^6.10.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "1.5.4",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.4",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.4"
  },
  "prisma": {
    "seed": "node scripts/db-seed.mjs"
  }
}
