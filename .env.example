# Runtime. All three have working defaults and are listed so nothing the code
# reads is invisible here. AUTH_MODE="demo" is refused when NODE_ENV=production.
NODE_ENV="development"
PORT="3000"
HOST="127.0.0.1"

# PostgreSQL connection string used by Prisma. Fill locally in .env; never commit real credentials.
# With the bundled docker-compose.yml the local value is:
#   postgresql://ai_agents:ai_agents_local_dev@localhost:5433/ai_agents?schema=public
#
# Leave it empty to run on the in-memory repository. A value that is set but is
# not a postgresql:// or postgres:// URL now stops the application instead of
# falling back to memory in silence.
DATABASE_URL=""

# Host port published by the PostgreSQL service in docker-compose.yml. Read by
# Docker, not by the application. Change it if 5433 is already taken.
POSTGRES_HOST_PORT="5433"

# Where business records are stored. "memory" keeps the offline default and
# needs no database; "postgres" reads them through Prisma and requires a valid
# DATABASE_URL. This is independent of BUSINESS_DATA_PROVIDER below, which says
# where the records came from rather than where they are kept.
BUSINESS_MEMORY_PROVIDER="memory"

# PostgreSQL integration tests are opt-in. Set this to true, with a valid
# DATABASE_URL, to run the 34 tests that are skipped otherwise.
RUN_POSTGRES_INTEGRATION="false"

# Business data source. Keep demo by default; future_real_data is an offline placeholder only.
BUSINESS_DATA_PROVIDER="demo"
BUSINESS_DATA_SOURCE_ID="demo"
BUSINESS_PROVIDER_ADAPTER="demo"

# AI provider boundary. Keep disabled until a real provider client is configured.
AI_PROVIDER="openai"
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gpt-5"
AI_PROVIDER_ENABLED="false"

# Planner selection. Supported values: deterministic, stub_llm, llm_mock, llm_openai.
PLANNER_PROVIDER="deterministic"

# LLM provider boundary. OpenAI is only used when PLANNER_PROVIDER="llm_openai".
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"

# Workflow boundary. Off by default. Setting WORKFLOW_ENABLED="true" requires
# WORKFLOW_PROVIDER="n8n" and a WORKFLOW_BASE_URL that can actually be called,
# otherwise the application refuses to start.
#
# The n8n client and its tool adapter now exist and are tested offline. Turning
# this on registers notify_delay_alert, and an approved delay alert really does
# leave the process. Left off, nothing outbound is reachable at all.
WORKFLOW_PROVIDER="mock"
WORKFLOW_BASE_URL=""
WORKFLOW_ENABLED="false"

# n8n specifics, required only once the boundary is enabled. The base URL is
# WORKFLOW_BASE_URL above: there is deliberately no second variable for it.
N8N_WEBHOOK_PATH=""
N8N_API_KEY_HEADER="X-AI-Agents-Token"
# Never fill this in here. It belongs in .env, which is git-ignored.
N8N_API_KEY=""
# Milliseconds. An unreachable n8n must not hold an orchestration step open.
N8N_TIMEOUT_MS="5000"

# API authentication. "token" requires a real bearer token for every /api call.
# "demo" additionally exposes GET /api/auth/demo-session and is refused when
# NODE_ENV=production. Create tokens with: npm run auth:create-token
AUTH_MODE="token"

# Request limits and rate limiting (per authenticated user, or per IP if anonymous).
API_BODY_LIMIT_BYTES="65536"
RATE_LIMIT_READ_MAX="240"
RATE_LIMIT_WRITE_MAX="60"
RATE_LIMIT_DECISION_MAX="20"

# H-KIDS document generation. The two reference templates are NOT shipped with
# the repository: the originals were filled documents carrying a customer's name
# and order. The company supplies its own blank templates and names them here.
# Without them, preview and generation stop with HKIDS_TEMPLATE_MISSING and say
# which variable to set. Use absolute paths.
HKIDS_INVOICE_TEMPLATE_PATH=""
HKIDS_DELIVERY_NOTE_TEMPLATE_PATH=""

# Optional SHA-256 lock, one per template. Set it and a template changed by a
# single byte is refused; leave it empty and no lock is applied. Compute it with
# any sha256 tool on the file you configured above.
HKIDS_INVOICE_TEMPLATE_CHECKSUM=""
HKIDS_DELIVERY_NOTE_TEMPLATE_CHECKSUM=""

# The PDF renderer embeds a real font file, so a .ttf has to exist on this
# machine. Left empty, it probes the usual locations: Arial on Windows and
# macOS, Liberation Sans then DejaVu Sans on Linux. If none is found, generation
# stops with a message naming the variable to set; it never falls back to a font
# nobody chose. Use absolute paths.
#   Windows  C:\Windows\Fonts\arial.ttf  and  C:\Windows\Fonts\arialbd.ttf
#   macOS    /System/Library/Fonts/Supplemental/Arial.ttf
#   Linux    /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
HKIDS_DOCUMENT_FONT_PATH=""
HKIDS_DOCUMENT_BOLD_FONT_PATH=""

# Logo drawn in the generated Word document. Defaults to the file versioned at
# assets/documents/hkids-logo.jpg, so this is only for overriding it.
HKIDS_LOGO_PATH=""
